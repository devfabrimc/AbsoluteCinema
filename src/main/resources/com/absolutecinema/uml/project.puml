@startuml

'==================================================
' ENUM
'==================================================

enum Role {
    ADMIN
    CUSTOMER

}


enum MovieStatus {
    ALL
    NOW_SHOWING
    COMING_SOON
}


enum Genre {
    TODOS
    ACCION
    ANIMACION
    AVENTURA
    BIOGRAFIA
    CIENCIA_FICCION
    COMEDIA
    CRIMEN
    DRAMA
    FANTASIA
    HISTORIA
    HORROR
    ROMANCE
    SUSPENSO
    TERROR
}


enum Language {
    SUB
    LAT
    ESP
    ENG
}


enum Format {
    TWO_D
    THREE_D
    IMAX
}



'==================================================
' MODELS
'==================================================

class User {
    -id : String
    -fullName : String
    -email : String
    -username : String
    -passwordHash : String
    -role : Role

    +User(id : String, fullName : String, email : String, username : String, passwordHash : String, role : Role)
    +isAdmin() : boolean
    +toString() : String
    +{static} fromString(line : String) : User
}



class Movie{
    - id : String
    - title : String
    - synopsis : String
    - genre : Genre
    - durationMinutes : int
    - rating : String
    - score : double
    - imagePath : String
    - bannerPath : String
    - status : MovieStatus
}


class Room{
    - id : String
    - name : String
    - rows : int
    - columns : int
    + fromString(line : String) : Room
}




class Seat{
    - row : int
    - column : int
    - label : String
}



class Showtime{
    - id : String
    - movieId : String
    - roomId : String
    - date : String
    - time : String
    - language : Language
    - format : Format
    - price : double
    - reservedSeats : List<String>
    + addReservedSeats(seatLabel : String) : void
}



class Ticket {
    -id : String
    -purchaseId : String
    -showtimeId : String
    -seatLabel : String
    -price : double

    +Ticket(id : String, purchaseId : String, showtimeId : String, seatLabel : String, price : double)
    +toString() : String
    +{static} fromString(line : String) : Ticket
}



class Purchase {
    -id : String
    -userId : String
    -purchaseDate : String
    -total : double

    +Purchase(id : String, userId : String, purchaseDate : String, total : double)
    +toString() : String
    +{static} fromString(line : String) : Purchase
}



'==================================================
' REPOSITORIES
'==================================================

interface Repository<T> {
    +findAll() : List<T>
    +findById(id:String) : T
    +save(object:T)
    +update(object:T)
    +delete(id:String)
}



class MovieRepository{
    - filePath : String
    - fileManager : TxtFileManager
    + findAll() : List<Movie>
    + findById(id : String) : Movie
    + save(movie : Movie) : void
    + update(movie : Movie) : void
    + delete (id : String) : void
    + findByStatus(status MovieStatus) : List<Movie>
    - writeAll(movies : List<Movie>) : void
}



class UserRepository {
    -{static} filepath : String
    -fileManager : TxtFileManager

    +findAll() : List<User>
    +findById(id : String) : User
    +save(user : User) : void
    +update(user : User) : void
    +delete(id : String) : void
    +findByUsername(username : String) : User
    +findByEmail(email : String) : User
    +getLastId() : String
    -writeAll(users : List<User>) : void
}



class RoomRepository{
    - filePath = String
    - fileManager = TxtFileManager
    + findAll() : List<Room>
    + findById(id : String) : Room
    + save(room : Room) : void
    + update(room : Room) : void
    + delete (id : String) : void
    + findByStatus(status MovieStatus) : List<Movie>
    - writeAll(rooms : List<Room>) : void
}



class ShowtimeRepository{
    - filePath : String
    - fileManager : TxtFileManager
    + findAll() : List<Showtime>
    + findById(id : String) : Showtime
    + save (showtime : Showtime) : void
    + update (showtime : Showtime) : void
    + delete (id : String) : void
    + findMovieId(movieId : String) : List<Showtime>
    - writeAll(showtimes : List<Showtime>) : void
}



class TicketRepository {
    +{static} filePath : String
    +fileManager : TxtFileManager

    +findAll() : List<Ticket>
    +findById(id : String) : Ticket
    +save(ticket : Ticket) : void
    +update(ticket : Ticket) : void
    +delete(id : String) : void
    +findByPurchaseId(purchaseId : String) : List<Ticket>
    +getLastId() : String
    -writeAll(tickets : List<Ticket>) : void
}



class PurchaseRepository {
    +{static} filePath : String
    +fileManager : TxtFileManager

    +findAll() : List<Purchase>
    +findById(id : String) : Purchase
    +save(purchase : Purchase) : void
    +update(purchase : Purchase) : void
    +delete(id : String) : void
    +findByUserId(userId : String) : List<Purchase>
    +getLastId() : String
    -writeAll(purchases : List<Purchase>) : void
}



Repository <|.. MovieRepository
Repository <|.. UserRepository
Repository <|.. RoomRepository
Repository <|.. ShowtimeRepository
Repository <|.. TicketRepository
Repository <|.. PurchaseRepository



'==================================================
' ENUM RELATIONS
'==================================================

User --> Role

Movie --> Genre
Movie --> MovieStatus

Showtime --> Language
Showtime --> Format



'==================================================
' SERVICES
'==================================================

class AuthService {
    -userRepository : UserRepository

    +AuthService(userRepository : UserRepository)
    +login(email : String, password : String) : User
    +register(fullName : String, email : String, username : String, password : String) : boolean
    +usernameExists(username : String) : boolean
    +emailExists(email : String) : boolean
}



class MovieService{
    - movieRepository : MovieRepository
    + filterMovies(title : String, genre : Genre) : List<Movie>
}



class ShowtimeService{
    - showtimeRepository : ShowtimeRepository
    - movieRepository : MovieRepository
    - roomRepository : RoomRepository

    + getShowtimesByMovie(movieId : String) : List<Showtime>
}


class PurchaseService {
    -purchaseRepository : PurchaseRepository
    -ticketRepository : TicketRepository
    -showtimeRepository : ShowtimeRepository

    +PurchaseService(purchaseRepository : PurchaseRepository, ticketRepository : TicketRepository, showtimeRepository : ShowtimeRepository)
    +purchase(userId : String, showtimeId : String, seats : List<String>) : Purchase
}



class SessionManager{
    - currentUser : User

    + login(user : User) : void
    + logout() : void
    + isLoggedIn() : boolean
    + isAdmin() : boolean
}



class PasswordUtils {
    +{static} hashPassword(password : String) : String
    +{static} verifyPassword(password : String, hash : String) : boolean
}



class TxtFileManager {
    +readLines(path : String) : List<String>
    +writeLines(path : String, lines : List<String>) : void
    +appendLine(path : String, lines : String) : void
}



'==================================================
' UTILS
'==================================================

class GenreFormatter {
    +format(genre : Genre) : String
}



class DurationFormatter {
    +format(duration : int) : String
}



'==================================================
' SERVICE RELATIONS
'==================================================

AuthService --> UserRepository
AuthService --> PasswordUtils

MovieService --> MovieRepository

ShowtimeService --> ShowtimeRepository
ShowtimeService --> MovieRepository
ShowtimeService --> RoomRepository

PurchaseService --> PurchaseRepository
PurchaseService --> TicketRepository
PurchaseService --> ShowtimeRepository

MovieRepository --> TxtFileManager
UserRepository --> TxtFileManager
RoomRepository --> TxtFileManager
ShowtimeRepository --> TxtFileManager
TicketRepository --> TxtFileManager
PurchaseRepository --> TxtFileManager

GenreFormatter --> Genre



'==================================================
' CONTROLLERS
'==================================================

class MenuController {
    -movieService : MovieService
    -navLabels : List<Label>
    -originalNowShowing : List<Movie>
    -originalComingSoon : List<Movie>

    +initialize(url : URL, resourceBundle : ResourceBundle) : void
    +refreshData() : void
    +openLoginOverlay() : void
    +openRegisterOverlay() : void
    +updateNavbarAfterLogin(userName : String) : void
    +openAdminMenu() : void
    +closeSession() : void

    -initOverlays() : void
    -initNavigation() : void
    -initFilterListeners() : void
    -loadGenres() : void
    -applyFilters() : void
    -loadCatalog(movies : List<Movie>) : void
    -loadUpcomingReleases(movies : List<Movie>) : void
    -ignoreVerticalScroll(event : ScrollEvent) : void
    -animateScrollTo(scrollPane : ScrollPane, targetSection : Node) : void
    -updateActiveLabel(selectedLabel : Label) : void
}



class LoginOverlayController {
    -authService : AuthService
    -parentController : MenuController

    +initialize() : void

    -handleLogin() : void
    -showErrorMessage(message : String) : void
    -resetForm() : void
    -closeModal() : void
}



class RegisterOverlayController {
    -authService : AuthService
    -parentController : MenuController

    +initialize() : void

    -handleRegistration() : void
    -showErrorMessage(message : String) : void
    -resetForm() : void
    -closeModal() : void
}



class MovieDetailsController{
    - movieRepository : MovieRepository
    - roomRepository : RoomRepository
    - showtimeRepository : ShowtimeRepository
    - showtimeService : ShowtimeService

    + initialize(location:URL, resources : ResourceBundle ) : void
    - loadShowTimes() : void
    - findPaneByTitle(title:String) : TitledPane
    - addShowtimeToPaneContent(pane : TitledPane,showtime : Showtime) : void
    - handleBuyAction(showtime : Showtime) : void

}



class SelectSeatsController{
    - selectedShowtime : Showtime
    - showtime : Showtime
    - movie : Movie
    - room : Room
    - movieRepository : MovieRepository
    - roomRepository : RoomRepository
    - selectedSeats : List<String>

    + initialize(location : URL, resourceBundle : ResourceBundle) : void
    - loadSeats(rows : int, columns : int) : void
    - updateSeatsLabel () : void
}



class PurchaseController {
    -movie : Movie
    -room : Room
    -showtime : Showtime
    -selectedSeats : List<String>
    -showtimeRepository : ShowtimeRepository
    -ticketRepository : TicketRepository
    -purchaseRepository : PurchaseRepository
    -purchaseService : PurchaseService

    +initialize(location : URL, resources : ResourceBundle) : void
    +setData(movie : Movie, room : Room, showtime : Showtime, selectedSeats : List<String>) : void
}



class AdminDashboardController{
    - movieService : MovieService
    - roomRepository : RoomRepository
    - showtimeRepository : ShowtimeRepository
    - userRepository : UserRepository

    + initialize(url : URL, resourceBundle : ResourceBundle) : void
    - loadDashboardMetrics() : void
    - loadMovies() : void
    - loadCbx() : void
    - createHeader() : HBox
}



