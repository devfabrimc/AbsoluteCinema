@startuml

title AbsoluteCinema - UML Final

'==================================================
' ENUMS
'==================================================

enum Role {
    ADMIN
    CUSTOMER
}

enum MovieStatus {
    NOW_SHOWING
    COMING_SOON
}

enum Genre {
    TODOS
    ACCION
    ANIMACION
    AVENTURA
    BIOGRAFIA
    CIENCIA_FICCION
    COMEDIA
    CRIMEN
    DRAMA
    FANTASIA
    HISTORIA
    HORROR
    ROMANCE
    SUSPENSO
    TERROR
}

enum Language {
    SUB
    LAT
    ESP
    ENG
}

enum Format {
    TWO_D
    THREE_D
    IMAX
}

'==================================================
' MODELS
'==================================================

class User{
    -id : String
    -fullName : String
    -email : String
    -username : String
    -passwordHash : String
    -role : Role
}

class Movie{
    -id : String
    -title : String
    -synopsis : String
    -genre : Genre
    -durationMinutes : int
    -rating : String
    -score : double
    -imagePath : String
    -bannerPath : String
    -status : MovieStatus
}

class Room{
    -id : String
    -name : String
    -rows : int
    -columns : int
}

class Seat{
    -row : int
    -column : int
    -label : String
}

class Showtime{
    -id : String
    -movieId : String
    -roomId : String
    -date : String
    -time : String
    -language : Language
    -format : Format
    -price : double
    -reservedSeats : List<String>
}

class Ticket{
    -id : String
    -purchaseId : String
    -showtimeId : String
    -seatLabel : String
    -price : double
}

class Purchase{
    -id : String
    -userId : String
    -purchaseDate : String
    -total : double
}

'==================================================
' REPOSITORIES
'==================================================

interface Repository<T>{
    +findAll() : List<T>
    +findById(id:String) : T
    +save(object:T)
    +update(object:T)
    +delete(id:String)
}

class MovieRepository{
    +findByStatus(status)
    +findByTitle(title)
    +findByGenre(genre)
    +getLastId()
}

class UserRepository{
    +findByUsername(username)
    +findByEmail(email)
    +getLastId()
}

class RoomRepository{
    +getLastId()
}

class ShowtimeRepository{
    +findByMovieId(movieId)
    +findByDate(date)
    +findByRoom(roomId)
    +getLastId()
}

class TicketRepository{
    +findByPurchaseId(purchaseId)
    +getLastId()
}

class PurchaseRepository{
    +findByUserId(userId)
    +getLastId()
}

Repository <|.. MovieRepository
Repository <|.. UserRepository
Repository <|.. RoomRepository
Repository <|.. ShowtimeRepository
Repository <|.. TicketRepository
Repository <|.. PurchaseRepository

'==================================================
' SERVICES
'==================================================

class AuthService{
    - userRepository : UserRepository

    + login(email : String, password : String) : User
    + register(fullName : String, email : String, username : String, password : String) : boolean
    + logout() : void
    + usernameExists(username : String) : boolean
    + emailExists(email : String) : boolean
}

class MovieService{
    - movieRepository : MovieRepository

    + getNowShowing() : List<Movie>
    + getComingSoon() : List<Movie>
    + searchByTitle(title : String) : List<Movie>
    + filterByGenre(genre : Genre) : List<Movie>
    + getMovieById(id : String) : Movie
    + getAllMovies() : List<Movie>
    + filterMovies(title : String, genre : Genre) : List<Movie>
}

class ShowtimeService{
    - showtimeRepository : ShowtimeRepository
    - movieRepository : MovieRepository
    - roomRepository : RoomRepository

    + getShowtimesByMovie(movieId : String) : List<Showtime>
    + getShowtimeById(id : String) : Showtime
    + getShowtimesByDate(date : String) : List<Showtime>
}

class SeatService{
    - showtimeRepository : ShowtimeRepository
    - roomRepository : RoomRepository

    + getSeatsForShowtime(showtimeId : String) : List<Seat>
    + getReservedSeats(showtimeId : String) : List<String>
    + isSeatAvailable(showtimeId : String, seatLabel : String) : boolean
}

class PurchaseService{
    - purchaseRepository : PurchaseRepository
    - ticketRepository : TicketRepository
    - showtimeRepository : ShowtimeRepository

    + purchase(userId : String, showtimeId : String, seats : List<String>) : Purchase
    + getPurchasesByUser(userId : String) : List<Purchase>
    + getTicketsByPurchase(purchaseId : String) : List<Ticket>
}

class AdminService{
    - movieRepository : MovieRepository
    - showtimeRepository : ShowtimeRepository
    - roomRepository : RoomRepository

    + addMovie(movie : Movie) : void
    + updateMovie(movie : Movie) : void
    + deleteMovie(movieId : String) : void

    + addShowtime(showtime : Showtime) : void
    + updateShowtime(showtime : Showtime) : void
    + deleteShowtime(showtimeId : String) : void

    + addRoom(room : Room) : void
    + updateRoom(room : Room) : void
    + deleteRoom(roomId : String) : void

    + getAllMovies() : List<Movie>
    + getAllShowtimes() : List<Showtime>
    + getAllRooms() : List<Room>
}

class SessionManager{
    - currentUser : User

    + login(user : User) : void
    + logout() : void
    + getCurrentUser() : User
    + isLoggedIn() : boolean
    + isAdmin() : boolean
}

class PasswordUtils{
    + hashPassword(password : String) : String
    + verifyPassword(password : String, hash : String) : boolean
}

class TxtFileManager{
    + readLines(path : String) : List<String>
    + writeLines(path : String, lines : List<String>) : void
    + appendLine(path : String, line : String) : void
}

class GenreFormatter {
    + format(genre : Genre) : String
}

class DurationFormatter {
    + format(duration : int) : String
}

'==================================================
' CONTROLLERS
'==================================================

class MenuController
class LoginOverlayController
class RegisterOverlayController

class MovieDetailsController{
    - movieService : MovieService
    - showtimeService : ShowtimeService

    + initialize() : void
    + loadMovie(movieId : String) : void
    + loadShowtimes(movieId : String) : void
    + goBack() : void
}

class SeatSelectionController{
    - seatService : SeatService
    - purchaseService : PurchaseService

    + initialize() : void
    + loadSeats(showtimeId : String) : void
    + confirmSelection() : void
}

class PurchaseController{
    - purchaseService : PurchaseService

    + initialize() : void
    + confirmPurchase() : void
    + cancelPurchase() : void
}

class ProfileController{
    - purchaseService : PurchaseService

    + initialize() : void
    + loadPurchases() : void
    + viewTicket(ticketId : String) : void
}

class AdminDashboardController

'==================================================
' DEPENDENCIES
'==================================================

AuthService --> UserRepository
AuthService --> PasswordUtils

MovieService --> MovieRepository

ShowtimeService --> ShowtimeRepository
ShowtimeService --> MovieRepository
ShowtimeService --> RoomRepository

SeatService --> ShowtimeRepository
SeatService --> RoomRepository

PurchaseService --> PurchaseRepository
PurchaseService --> TicketRepository
PurchaseService --> ShowtimeRepository

AdminService --> MovieRepository
AdminService --> ShowtimeRepository
AdminService --> RoomRepository

MovieRepository --> TxtFileManager
UserRepository --> TxtFileManager
RoomRepository --> TxtFileManager
ShowtimeRepository --> TxtFileManager
TicketRepository --> TxtFileManager
PurchaseRepository --> TxtFileManager

MovieRepository --> Movie
UserRepository --> User
RoomRepository --> Room
ShowtimeRepository --> Showtime
TicketRepository --> Ticket
PurchaseRepository --> Purchase

MenuController --> MovieService
MenuController --> AuthService

LoginOverlayController --> AuthService
LoginOverlayController --> SessionManager

RegisterOverlayController --> AuthService

MovieDetailsController --> ShowtimeService

SeatSelectionController --> SeatService

PurchaseController --> PurchaseService

ProfileController --> PurchaseService

AdminDashboardController --> AdminService

'==================================================
' RELACIONES
'==================================================

User "1" --> "0..*" Purchase

Purchase "1" --> "1..*" Ticket

Ticket --> Showtime

Showtime --> Movie

Showtime --> Room

Room "1" --> "0..*" Seat

@enduml