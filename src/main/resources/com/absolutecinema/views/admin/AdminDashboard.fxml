                                          <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: innershadow(gaussian, #D6A85A, 100, 0.5, 0, 0);">
                                             <image>
                                                <Image url="@../../images/admin.png" />
                                             </image>
                                          </ImageView>
                                          <VBox alignment="CENTER_LEFT">
                                             <children>
