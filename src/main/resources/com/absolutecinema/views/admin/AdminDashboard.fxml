                        <HBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <children>
                              <VBox spacing="10.0" styleClass="container" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox maxWidth="1.7976931348623157E308" spacing="10.0">
