                                                <Image url="@../../images/movie.png" />
                                             </image>
                                          </ImageView>
                                       </graphic>
                                    </Button>
                                    <Button alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openShowtimeMenu" styleClass="btn-menu" text="Funciones">
