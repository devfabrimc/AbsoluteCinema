@startuml

title AbsoluteCinema - UML Final

'==================================================
' ENUMS
'==================================================

enum Role {
    ADMIN
    CUSTOMER
}

enum MovieStatus {
    NOW_SHOWING
    COMING_SOON
}

enum Genre {
    ACCION
    ANIMACION
    AVENTURA
    BIOGRAFIA
    CIENCIA_FICCION
    COMEDIA
    CRIMEN
    DRAMA
    FANTASIA
    HISTORIA
    HORROR
    ROMANCE
    SUSPENSO
    TERROR
}

enum Language {
    SUB
    LAT
    ESP
    ENG
}

enum Format {
    TWO_D
    THREE_D
    IMAX
}

'==================================================
' MODELS
'==================================================

class User{
    -id : String
    -fullName : String
    -email : String
    -username : String
    -passwordHash : String
    -role : Role

    +isAdmin() : boolean
}

class Movie{
    -id : String
    -title : String
    -synopsis : String
    -genre : Genre
    -durationMinutes : int
    -rating : String
    -score : double
    -imagePath : String
    -bannerPath : String
    -status : MovieStatus

    +isNowShowing() : boolean
    +isComingSoon() : boolean
}

class Room{
    -id : String
    -name : String
    -rows : int
    -columns : int
}

class Seat{
    -row : int
    -column : int
    -label : String
}

class Showtime{
    -id : String
    -movieId : String
    -roomId : String
    -date : String
    -time : String
    -language : Language
    -format : Format
    -price : double
    -reservedSeats : List<String>
}

class Ticket{
    -id : String
    -purchaseId : String
    -showtimeId : String
    -seatLabel : String
    -price : double
}

class Purchase{
    -id : String
    -userId : String
    -purchaseDate : String
    -total : double
}

'==================================================
' REPOSITORIES
'==================================================

interface Repository<T>{
    +findAll() : List<T>
    +findById(id:String) : T
    +save(object:T)
    +update(object:T)
    +delete(id:String)
}

class MovieRepository{
    +findByStatus(status)
    +findByTitle(title)
    +findByGenre(genre)
    +getLastId()
}

class UserRepository{
    +findByUsername(username)
    +findByEmail(email)
    +getLastId()
}

class RoomRepository{
    +getLastId()
}

class ShowtimeRepository{
    +findByMovieId(movieId)
    +findByDate(date)
    +findByRoom(roomId)
    +getLastId()
}

class TicketRepository{
    +findByPurchaseId(purchaseId)
    +getLastId()
}

class PurchaseRepository{
    +findByUserId(userId)
    +getLastId()
}

Repository <|.. MovieRepository
Repository <|.. UserRepository
Repository <|.. RoomRepository
Repository <|.. ShowtimeRepository
Repository <|.. TicketRepository
Repository <|.. PurchaseRepository

'==================================================
' SERVICES
'==================================================

class AuthService{
    +login(username,password)
    +register(...)
    +logout()
    +usernameExists(username)
    +emailExists(email)
}

class MovieService{
    +getNowShowing()
    +getComingSoon()
    +searchByTitle(text)
    +filterByGenre(genre)
    +getMovieById(id)
    +getAllMovies()
}

class ShowtimeService{
    +getShowtimesByMovie(movieId)
    +getShowtimeById(id)
    +getShowtimesByDate(date)
}

class SeatService{
    +getSeatsForShowtime(showtimeId)
    +getReservedSeats(showtimeId)
    +isSeatAvailable(showtimeId,seat)
}

class PurchaseService{
    +purchase(userId,showtimeId,seats)
    +getPurchasesByUser(userId)
    +getTicketsByPurchase(purchaseId)
}

class AdminService{
    +addMovie(movie)
    +updateMovie(movie)
    +deleteMovie(movieId)

    +addShowtime(showtime)
    +updateShowtime(showtime)
    +deleteShowtime(showtimeId)

    +addRoom(room)
    +updateRoom(room)
    +deleteRoom(roomId)

    +getAllMovies()
    +getAllShowtimes()
    +getAllRooms()
}

class SessionManager{
    -currentUser : User

    +login(user)
    +logout()
    +getCurrentUser()
    +isLoggedIn()
    +isAdmin()
}

class PasswordUtils{
    +hashPassword(password)
    +verifyPassword(password,hash)
}

class TxtFileManager{
    +readLines(path)
    +writeLines(path,lines)
    +appendLine(path,line)
}

'==================================================
' CONTROLLERS
'==================================================

class MenuController
class LoginOverlayController
class RegisterOverlayController
class MovieDetailsController
class SeatSelectionController
class PurchaseController
class ProfileController
class AdminDashboardController

'==================================================
' DEPENDENCIES
'==================================================

AuthService --> UserRepository
AuthService --> PasswordUtils

MovieService --> MovieRepository

ShowtimeService --> ShowtimeRepository
ShowtimeService --> MovieRepository
ShowtimeService --> RoomRepository

SeatService --> ShowtimeRepository
SeatService --> RoomRepository

PurchaseService --> PurchaseRepository
PurchaseService --> TicketRepository
PurchaseService --> ShowtimeRepository

AdminService --> MovieRepository
AdminService --> ShowtimeRepository
AdminService --> RoomRepository

MovieRepository --> TxtFileManager
UserRepository --> TxtFileManager
RoomRepository --> TxtFileManager
ShowtimeRepository --> TxtFileManager
TicketRepository --> TxtFileManager
PurchaseRepository --> TxtFileManager

MovieRepository --> Movie
UserRepository --> User
RoomRepository --> Room
ShowtimeRepository --> Showtime
TicketRepository --> Ticket
PurchaseRepository --> Purchase

MenuController --> MovieService
MenuController --> AuthService

LoginOverlayController --> AuthService
LoginOverlayController --> SessionManager

RegisterOverlayController --> AuthService

MovieDetailsController --> ShowtimeService

SeatSelectionController --> SeatService

PurchaseController --> PurchaseService

ProfileController --> PurchaseService

AdminDashboardController --> AdminService

'==================================================
' RELACIONES
'==================================================

User "1" --> "0..*" Purchase

Purchase "1" --> "1..*" Ticket

Ticket --> Showtime

Showtime --> Movie

Showtime --> Room

Room "1" --> "0..*" Seat

@enduml