'==================================================
' MODEL RELATIONS
'==================================================

User "1" --> "0..*" Purchase

Purchase "1" --> "1..*" Ticket

Ticket "*" --> "1" Showtime

Showtime "*" --> "1" Movie

Showtime "*" --> "1" Room

Room "1" --> "0..*" Seat



'==================================================
' REPOSITORY MODEL RELATIONS
'==================================================

MovieRepository --> Movie
UserRepository --> User
RoomRepository --> Room
ShowtimeRepository --> Showtime
TicketRepository --> Ticket
PurchaseRepository --> Purchase

@enduml