<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" stylesheets="@../../styles/app.css" visible="false" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.absolutecinema.controller.admin.AddMovieOverlayController">
   <children>
      <StackPane layoutX="10.0" layoutY="10.0" styleClass="modal-overlay" stylesheets="@../../styles/add-movie.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="600.0" styleClass="modal-content">
               <children>
                  <HBox fillHeight="false">
                     <children>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#closeModal" styleClass="close-btn">
                           <graphic>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: innershadow(gaussian, #FFF, 30, 0.5, 0, 0);">
                                 <image>
                                    <Image url="@../../images/close.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <ImageView fitWidth="50.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: innershadow(gaussian, #D6A85A, 100, 0.5, 0, 0);">
                           <image>
                              <Image url="@../../images/plus.png" />
                           </image>
                        </ImageView>
                        <VBox alignment="BOTTOM_LEFT">
                           <children>
                              <Label alignment="CENTER" style="-fx-padding: 0;" styleClass="modal-title" text="NUEVA PELÍCULA" />
                              <Label alignment="CENTER" styleClass="modal-subtitle" text="Completa la información de la nueva película.">
                                 <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <Separator opacity="0.1">
                     <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </VBox.margin></Separator>
                  <HBox spacing="20.0">
                     <children>
                        <VBox maxWidth="1.7976931348623157E308" spacing="15.0">
                           <children>
                              <VBox>
                                 <children>
                                    <Label styleClass="info-text" text="Título" />
                                    <TextField fx:id="lblTitle" promptText="Ej. Interestelar" styleClass="input" />
                                 </children>
                              </VBox>
                              <VBox>
                                 <children>
                                    <Label styleClass="info-text" text="Sinópsis" />
                                    <TextArea fx:id="lblSynopsis" prefHeight="225.0" prefWidth="200.0" promptText="Escriba la sinopsis de la película..." styleClass="input" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox>
                                 <children>
                                    <Label styleClass="info-text" text="Género" />
                                    <ComboBox fx:id="cbxGenres" maxWidth="1.7976931348623157E308" promptText="Seleccionar género" />
                                 </children>
                              </VBox>
                              <VBox>
                                 <children>
                                    <Label styleClass="info-text" text="Puntuación" />
                                    <TextField fx:id="lblScore" promptText="Ej. 8.7" styleClass="input" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                        <VBox maxWidth="1.7976931348623157E308" spacing="15.0">
                           <children>
                              <HBox spacing="15.0">
                                 <children>
                                    <VBox HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="info-text" text="Duración (min)" />
                                          <TextField fx:id="lblDuration" promptText="Ej. 169" styleClass="input" />
                                       </children>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="info-text" text="Clasificación" />
                                          <TextField fx:id="lblRating" promptText="Ej. PG-13" styleClass="input" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <VBox>
                                 <children>
                                    <Label styleClass="info-text" text="Imagen de póster" />
                                    <VBox fx:id="uploadBoxImage" alignment="CENTER" prefHeight="0.0" prefWidth="0.0" styleClass="upload-box">
                                       <children>
                                          <ImageView fitWidth="60.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: innershadow(gaussian, #D6A85A, 100, 0.5, 0, 0);">
                                             <image>
                                                <Image url="@../../images/upload.png" />
                                             </image>
                                          </ImageView>
                                          <Label alignment="CENTER" text="Seleccionar Imagen" />
                                          <Label alignment="CENTER" styleClass="label-info" text="Formato: PNG" />
                                       </children>
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                       <VBox.margin>
                                          <Insets top="5.0" />
                                       </VBox.margin>
                                    </VBox>
                                 </children>
                              </VBox>
                              <VBox>
                                 <children>
                                    <Label styleClass="info-text" text="Imagen del banner" />
                                    <VBox fx:id="uploadBoxBanner" alignment="CENTER" prefHeight="0.0" prefWidth="0.0" styleClass="upload-box">
                                       <children>
                                          <ImageView fitWidth="60.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: innershadow(gaussian, #D6A85A, 100, 0.5, 0, 0);">
                                             <image>
                                                <Image url="@../../images/upload.png" />
                                             </image>
                                          </ImageView>
                                          <Label alignment="CENTER" text="Seleccionar Imagen" />
                                          <Label alignment="CENTER" styleClass="label-info" text="Formato: PNG" />
                                       </children>
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                       <VBox.margin>
                                          <Insets top="5.0" />
                                       </VBox.margin>
                                    </VBox>
                                 </children>
                              </VBox>
                              <VBox>
                                 <children>
                                    <Label styleClass="info-text" text="Estado" />
                                 </children>
                              </VBox>
                              <HBox alignment="CENTER">
                                 <children>
                                    <RadioButton fx:id="rbShowing" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="true" text="En cartelera" HBox.hgrow="ALWAYS">
                                       <toggleGroup>
                                          <ToggleGroup fx:id="status" />
                                       </toggleGroup>
                                    </RadioButton>
                                    <RadioButton fx:id="rbComingSoon" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Próximamente" toggleGroup="$status" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <Separator opacity="0.1">
                     <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </VBox.margin>
                  </Separator>
                  <Label fx:id="lblErrorMessage" text="ErrorMessage">
                     <styleClass>
                        <String fx:value="error-message" />
                        <String fx:value="set-unvisible" />
                     </styleClass>
                  </Label>
                  <HBox spacing="15.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#closeModal" styleClass="secondary-button" text="Cancelar" HBox.hgrow="ALWAYS">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor></Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#saveMovie" styleClass="primary_button" text="Guardar película" HBox.hgrow="ALWAYS">
                           <graphic>
                              <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../../images/save.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <StackPane.margin>
                  <Insets />
               </StackPane.margin>
               <padding>
                  <Insets left="30.0" right="30.0" />
               </padding>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
